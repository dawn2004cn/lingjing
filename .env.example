# LLM（DeepSeek / OpenAI 兼容；未配置时走规则解读，不调用模型）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# JWT（生产环境务必更换）
JWT_SECRET=your-secret-key-change-in-production

# 会员档 LLM 日额度（上海时区日历日；支付未接，专业档由管理员开通）
# PLAN_FREE_DAILY_LLM=5
# PLAN_PRO_DAILY_LLM=50

# 专业档标价（分）与演示支付（默认开启；生产可设 PLAN_ALLOW_MOCK_PAY=0）
# PLAN_PRO_PRICE_FEN=9900
# PLAN_ALLOW_MOCK_PAY=1
# PLAN_MOCK_WEBHOOK_SECRET=

# 可选：太乙/皇极 Python sidecar（见 services/py-engine）
# PY_ENGINE_URL=http://127.0.0.1:8765
