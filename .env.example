# LLM（DeepSeek / OpenAI 兼容；未配置时走规则解读，不调用模型）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# JWT（生产环境务必更换）
JWT_SECRET=your-secret-key-change-in-production

# 会员档 LLM 日额度（上海时区日历日）
# PLAN_FREE_DAILY_LLM=5
# PLAN_PRO_DAILY_LLM=50

# 专业档标价（分）与演示支付（默认开启；生产可设 PLAN_ALLOW_MOCK_PAY=0）
# PLAN_PRO_PRICE_FEN=9900
# PLAN_ALLOW_MOCK_PAY=1

# 支付回调共用密钥（微信/支付宝 notify 必填）
# PLAN_PAY_NOTIFY_SECRET=change-me
# 对外站点根 URL（写入 notify_url / return_url）
# PLAN_PAY_PUBLIC_BASE_URL=https://your.domain
# 预下单默认 dry-run（本地签名，不请求微信/支付宝网关）；联调设 0
# PLAN_PAY_DRY_RUN=1

# 微信支付 APIv3 Native
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_MCH_SERIAL=
# WECHAT_PAY_MCH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 支付宝电脑网站支付
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 可选：太乙/皇极 Python sidecar（见 services/py-engine）
# PY_ENGINE_URL=http://127.0.0.1:8765
